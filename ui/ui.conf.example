# secsec desktop UI config: secsec/ui.conf in $XDG_CONFIG_HOME, else ~/.config (the UIs and the installer write it for you).

# The folder to keep in sync, linked once with `secsec sync <folder> --server <host> --pin <host pin> --once` (default ~/cloud; ~ is expanded).
folder=~/cloud

# SSH private key (blank: ~/.ssh/id_ed25519; ~ is expanded).
#key=~/.ssh/id_ed25519

# The secsec binary (blank: the install directories and PATH; the installer sets it).
#bin=/usr/local/bin/secsec
